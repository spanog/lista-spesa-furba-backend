# --- Local development (official workflow) -----------------------------------
# Supabase CLI provides local services. FastAPI runs separately on host.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SECRET_KEY=<local-service-role-key>
SUPABASE_JWT_SECRET=<local-jwt-secret>
APP_SESSION_SECRET=<random-secret-min-32-chars>  # HS256 secret for girospesa_session cookie; must match Next.js APP_SESSION_SECRET
# Direct Postgres DSN — required for concurrent-safe RPC mutations (append/remove/update_list_item)
# Local value: postgresql://postgres:postgres@127.0.0.1:54322/postgres
DB_DSN=
ADMIN_EMAIL=
ADMIN_PASSWORD=
WEBMASTER_EMAIL=webmaster@example.com
MAIL_FROM=no-reply@girospesa.local
SMTP_HOST=127.0.0.1
SMTP_PORT=54325
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false

LLM_PROVIDER=gemini
GOOGLE_API_KEY=
GEMINI_MODEL=gemma-4-31b-it


VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_MAILTO=mailto:admin@girospesa.it
FCM_ENABLED=false
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
OPS_CRON_SECRET=
FRONTEND_URL=http://127.0.0.1:3000
BACKEND_URL=http://localhost:8000

# Copy local values from: supabase status -o env
# SUPABASE_SECRET_KEY        <- SERVICE_ROLE_KEY
# SUPABASE_JWT_SECRET       <- JWT_SECRET
# For admin seeding, set ADMIN_EMAIL and ADMIN_PASSWORD explicitly.

# --- Cloud / deployed environment -------------------------------------------
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SECRET_KEY=<service-role-key>
# SUPABASE_JWT_SECRET=<jwt-secret>
# APP_SESSION_SECRET=<random-secret-min-32-chars>
# DB_DSN=<direct-postgres-connection-string>
# GOOGLE_API_KEY=<google-api-key>
# FCM_ENABLED=true
# FCM_PROJECT_ID=<firebase-project-id>
# FCM_CLIENT_EMAIL=<firebase-service-account-email>
# FCM_PRIVATE_KEY="<firebase-private-key-with-escaped-newlines>"
# OPS_CRON_SECRET=<random-secret-for-github-scheduled-maintenance>
# FRONTEND_URL=https://www.girospesa.it
# BACKEND_URL=https://api.girospesa.it
